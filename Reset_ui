local function PlayBounce(b)
    local oS,oP=b.Size,b.Position
    local t1=TweenService:Create(b,TweenInfo.new(.08,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=UDim2.new(oS.X.Scale,oS.X.Offset-4,oS.Y.Scale,oS.Y.Offset-4),Position=UDim2.new(oP.X.Scale,oP.X.Offset+2,oP.Y.Scale,oP.Y.Offset+2)})
    local t2=TweenService:Create(b,TweenInfo.new(.16,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=oS,Position=oP})
    t1:Play() t1.Completed:Connect(function() t2:Play() end)
end

